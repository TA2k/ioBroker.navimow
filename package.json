{
  "name": "iobroker.navimow",
  "version": "1.1.1",
  "description": "Adapter for NaviMower from Segway",
  "author": {
    "name": "TA2k",
    "email": "tombox2020@gmail.com"
  },
  "homepage": "https://github.com/TA2k/ioBroker.navimow",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "navimower",
    "segway"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TA2k/ioBroker.navimow.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@napi-rs/canvas": "^1.0.3",
    "axios": "^1.19.0",
    "json2iob": "^2.6.25",
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@eslint/js": "^10.0.1",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^20.19.43",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/TA2k/ioBroker.navimow/issues"
  },
  "readmeFilename": "README.md"
}
