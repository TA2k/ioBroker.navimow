{
  "type": "panel",
  "i18n": true,
  "items": {
    "_oauth_header": {
      "type": "header",
      "text": "oauthHeader",
      "size": 3,
      "newLine": true
    },
    "_oauth_info": {
      "type": "staticText",
      "text": "oauthInfo",
      "newLine": true,
      "xs": 12, "sm": 12, "md": 12, "lg": 12, "xl": 12
    },
    "_oauth_link": {
      "type": "staticLink",
      "href": "https://navimow-h5-fra.willand.com/smartHome/login?channel=homeassistant&client_id=homeassistant&response_type=code&redirect_uri=http%3A%2F%2Flocalhost%3A1%2Fcallback",
      "label": "oauthLink",
      "newLine": true,
      "xs": 12, "sm": 4, "md": 4, "lg": 4, "xl": 4,
      "button": true
    },
    "authCode": {
      "type": "text",
      "newLine": true,
      "xs": 12, "sm": 6, "md": 6, "lg": 6, "xl": 6,
      "label": "authCodeLabel",
      "help": "authCodeHelp"
    },
    "interval": {
      "type": "number",
      "newLine": true,
      "min": 0,
      "max": 1440,
      "step": 1,
      "xs": 12, "sm": 2, "md": 2, "lg": 2, "xl": 2,
      "label": "intervalLabel",
      "help": "intervalHelp"
    },
    "_map_header": {
      "type": "header",
      "text": "mapHeader",
      "size": 3,
      "newLine": true
    },
    "mapEnabled": {
      "type": "checkbox",
      "newLine": true,
      "xs": 12, "sm": 12, "md": 6, "lg": 6, "xl": 6,
      "label": "mapEnabledLabel",
      "help": "mapEnabledHelp"
    },
    "mapLineColor": {
      "type": "color",
      "newLine": true,
      "xs": 12, "sm": 4, "md": 3, "lg": 3, "xl": 3,
      "label": "mapLineColorLabel",
      "help": "mapLineColorHelp"
    },
    "mapLineOpacity": {
      "type": "number",
      "min": 0.05,
      "max": 1,
      "step": 0.05,
      "xs": 12, "sm": 4, "md": 3, "lg": 3, "xl": 3,
      "label": "mapLineOpacityLabel",
      "help": "mapLineOpacityHelp"
    },
    "mapLineWidth": {
      "type": "number",
      "min": 0.5,
      "max": 10,
      "step": 0.5,
      "xs": 12, "sm": 4, "md": 3, "lg": 3, "xl": 3,
      "label": "mapLineWidthLabel"
    },
    "mapMarker": {
      "type": "select",
      "newLine": true,
      "xs": 12, "sm": 4, "md": 3, "lg": 3, "xl": 3,
      "label": "mapMarkerLabel",
      "options": [
        {
          "value": "dot",
          "label": "markerDot"
        },
        {
          "value": "mower",
          "label": "markerMower"
        }
      ]
    },
    "mapMarkerSize": {
      "type": "number",
      "min": 4,
      "max": 60,
      "step": 1,
      "xs": 12, "sm": 4, "md": 3, "lg": 3, "xl": 3,
      "label": "mapMarkerSizeLabel",
      "help": "mapMarkerSizeHelp"
    },
    "mapRenderInterval": {
      "type": "number",
      "min": 1,
      "max": 30,
      "step": 1,
      "newLine": true,
      "xs": 12, "sm": 4, "md": 3, "lg": 3, "xl": 3,
      "label": "mapRenderIntervalLabel",
      "help": "mapRenderIntervalHelp"
    }
  }
}
